{
  "expo": {
    "name": "Finzz",
    "slug": "finzz",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "updates": {
      "url": "https://u.expo.dev/95f1c3b4-8c45-4dfa-876e-48a02ceaae1d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aryanseth9795.finzz"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3B4FD8"
      },
      "package": "com.aryanseth9795.finzz",
      "edgeToEdgeEnabled": true,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "versionCode": 1,
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Finzz to access your photos to set a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#007AFF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "95f1c3b4-8c45-4dfa-876e-48a02ceaae1d"
      }
    }
  }
}
